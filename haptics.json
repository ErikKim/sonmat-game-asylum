 "rules": [
  {
   "match": "^(MUS_|UI_|AMBI_|Tape_|TAP_|DV_OracleRadio|DV_BatWrist|DV_Decipher|DV_SonicRes|DV_SporeScanner|FR_|PL_BeltSFX|PL_CapeSFX\\.bm_gen_|PL_FootSteps_\\w+\\.(Turn|SlideStop)|EN_\\w*(Emote|Vocal|Breathe|Foley)|EN_WhooshesSFX|EN_FootstepsSFX|NPC_)",
